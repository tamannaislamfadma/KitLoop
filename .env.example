# Database Configuration
KITLOOP_DB_USERNAME=your_database_username
KITLOOP_DB_PASSWORD=your_database_password

# Email Configuration
KITLOOP_MAIL_HOST=smtp.gmail.com
KITLOOP_MAIL_PORT=587
KITLOOP_MAIL_USERNAME=your_email@gmail.com
KITLOOP_MAIL_PASSWORD=your_email_app_password
KITLOOP_MAIL_FROM=your_email@gmail.com

# OTP Configuration
KITLOOP_OTP_EXPIRY_MINUTES=5
KITLOOP_OTP_RESEND_COOLDOWN_SECONDS=60

# Admin Configuration
KITLOOP_ADMIN_NAME=Admin
KITLOOP_ADMIN_EMAIL=admin@example.com
KITLOOP_ADMIN_PASSWORD=change_this_password
KITLOOP_ADMIN_PHONE=your_phone_number

# Upload Configuration
KITLOOP_EQUIPMENT_UPLOAD_DIR=uploads/equipment
KITLOOP_PAYMENT_UPLOAD_DIR=uploads/payments
